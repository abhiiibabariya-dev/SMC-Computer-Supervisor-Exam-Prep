name: Gujarat Government Jobs Monitor

on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  monitor:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Scan Gujarat government recruitment sources
        run: |
          python3 gujarat-monitor/smc_jobs.py

      - name: Show monitor report
        run: |
          cat gujarat-monitor/jobs_report.json

      - name: Commit updated Gujarat jobs data
        run: |
          git config user.name "Gujarat Jobs Monitor"
          git config user.email "actions@github.com"

          git add gujarat-monitor/jobs.json
          git add gujarat-monitor/jobs_state.json
          git add gujarat-monitor/jobs_report.json
          git add gujarat-jobs.json

          if git diff --staged --quiet; then
            echo "No changes detected."
          else
            git commit -m "chore: update Gujarat government jobs"
            git push
          fi
