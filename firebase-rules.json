{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth !== null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth !== null && (auth.token.admin === true || (auth.uid === $uid && !data.exists()))",
        ".validate": "auth.token.admin === true || (auth.uid === $uid && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('email').val().toLowerCase() === auth.token.email.toLowerCase() && newData.child('plan').val() === 'free' && newData.child('planLabel').val() === 'Free' && newData.child('subscriptionStatus').val() === 'none' && newData.child('expiresAt').val() === null && (!newData.hasChild('emailVerified') || newData.child('emailVerified').val() === false) && (!newData.hasChild('phoneVerified') || newData.child('phoneVerified').val() === false) && (!newData.hasChild('entitlements') || (newData.child('entitlements').child('mockTests').val() === false && newData.child('entitlements').child('fullAccess').val() === false)))",
        "emailVerified": {
          ".write": "auth !== null && (auth.token.admin === true || (auth.uid === $uid && auth.token.email_verified === true))",
          ".validate": "newData.val() === true || (auth.uid === $uid && !data.exists() && newData.val() === false)"
        },
        "mobile": {
          ".write": "auth !== null && (auth.token.admin === true || auth.uid === $uid)",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10}$/)"
        },
        "plan": {
          ".write": "auth !== null && auth.token.admin === true"
        },
        "planLabel": {
          ".write": "auth !== null && auth.token.admin === true"
        },
        "subscriptionStatus": {
          ".write": "auth !== null && auth.token.admin === true"
        },
        "expiresAt": {
          ".write": "auth !== null && auth.token.admin === true"
        },
        "entitlements": {
          ".write": "auth !== null && auth.token.admin === true"
        }
      }
    },
    "payment_requests": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".read": "auth !== null && (auth.token.admin === true || data.child('uid').val() === auth.uid)",
        ".write": "auth !== null && (auth.token.admin === true || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending'))"
      }
    },
    "premium_content": {
      "$resource": {
        ".read": "auth !== null && (auth.token.admin === true || auth.token.premium === true)",
        ".write": "auth !== null && auth.token.admin === true"
      }
    },
    "audit": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','ev','t'])"
      }
    },
    "auth_audit": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','event','t'])"
      }
    },
    "visits": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','timestamp','localTime','deviceType','os','browser','page'])"
      }
    },
    "clicks": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','text','time','page'])"
      }
    },
    "leads": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','name','email'])"
      }
    },
    "security": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','src','time','localTime','type','msg','level','ua','page'])"
      }
    },
    "quizscores": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && (auth.token.admin === true || (!data.exists() && newData.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid','name','mobile','type','score','total','date','t','streak']) && newData.child('uid').val() === auth.uid && newData.child('type').val() === 'daily' && newData.child('score').isNumber() && newData.child('total').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= newData.child('total').val()"
      }
    },
    "leaderboard": {
      ".read": "auth !== null && auth.token.admin === true",
      "$id": {
        ".write": "auth !== null && auth.token.admin === true",
        ".validate": "newData.hasChildren(['name','mobile','subj','score','total','secs','t']) && newData.child('score').isNumber() && newData.child('total').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= newData.child('total').val()"
      }
    },
    "leaderboard_public": {
      ".read": "auth !== null",
      "$id": {
        ".write": "auth !== null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','name','subj','score','total','secs','t']) && !newData.hasChild('mobile') && !newData.hasChild('email') && !newData.hasChild('phone') && newData.child('uid').val() === auth.uid && newData.child('score').isNumber() && newData.child('total').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= newData.child('total').val() && newData.child('secs').isNumber() && newData.child('t').isString()"
      }
    }
  }
}